# Documents every environment variable. Copy the values you need into .env.<mode>.local
# (gitignored) to override them on your machine. Public values only: VITE_* is shipped to the browser.
#
# VITE_APP_ENV: development | test | uat | production
# VITE_API_BASE_URL: absolute http(s) URL of the backend for this environment
# VITE_API_TIMEOUT_MS: optional request timeout in milliseconds (default 10000)
VITE_APP_ENV=development
VITE_API_BASE_URL=https://api.example.com
VITE_API_TIMEOUT_MS=10000
