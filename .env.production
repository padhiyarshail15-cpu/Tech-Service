# Loaded by `yarn dev:prod`, and by every build for the deployed domain table.
# Public values only: VITE_* is shipped to the browser.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.example.com
# Deployed domains that run as this environment (comma-separated)
VITE_APP_HOSTS=my-project-sigma-seven-36.vercel.app
