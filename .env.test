# Loaded by `yarn dev:test`, and by every build for the deployed domain table.
# Public values only: VITE_* is shipped to the browser.
VITE_APP_ENV=test
VITE_API_BASE_URL=https://api-test.example.com
# Deployed domains that run as this environment (comma-separated)
VITE_APP_HOSTS=tech-service-test.vercel.app
